# Copy to .env and fill in. .env is gitignored — NEVER commit real secrets.

# --- Code-agent backend (the LLM CLI the loop drives) ---
# The agent command itself is set in config/harness.json (agent.command). Provide its key/host here.
BCF_API_KEY=
BCF_API_HOST=https://api.your-provider.example
# Optional default model id (config/harness.json models.* override per role)
BCF_MODEL=

# --- Per-role model/endpoint/key overrides for invoker scripts (agents/bin/invoke-*.ps1) ---
# Leave empty to fall back to BCF_API_* above.
BCF_RETROSPECTOR_MODEL=
BCF_SUPERVISOR_MODEL=
BCF_TEST_AUTHOR_MODEL=
BCF_REFERENCE_DIGESTER_MODEL=

# --- pgvector memory stack (optional; features.memory) ---
# Local-dev default for the container password lives in config/memory.config.json (non-secret).
# Set a real value for anything shared.
BCF_PG_PASSWORD=bcf_local_dev

# --- Embedding server (optional; LM Studio or any OpenAI-compatible /v1/embeddings) ---
# Defaults are in config/memory.config.json / memory/history; override here if needed.
MEMORY_EMBED_URL=http://localhost:1234/v1/embeddings
MEMORY_EMBED_MODEL=
MEMORY_EMBED_DIM=

# --- Optional toggles (defaults are safe) ---
# BCF_MEMORY_DISABLED=1        # force-disable the vector-memory bridge
# BCF_PROJECT_ROOT=            # override repo root (else auto-detected)
# BCF_BASH=                    # path to bash if not on PATH
