# Образец окружения фабрики. Скопируй в .env рядом с проектом и заполни нужное.
# .env в git не попадает (.gitignore) — настоящие ключи держи только там.
#
# ЗДЕСЬ ТОЛЬКО ИМЕНА, БЕЗ ЗНАЧЕНИЙ. Пример со значением живёт своей жизнью: он
# копируется в .env целиком, и «пример» становится настройкой, которую никто не выбирал.
# Дефолты у переменных уже есть — в конфигах и в самих скриптах; пустая строка тут
# означает ровно «взять дефолт».
#
# Перечислено всё, что читает обвязка. Переменные, которые `bcf` выставляет сам, тоже в
# списке: их не нужно заполнять, но нужно знать, что они существуют — иначе при ручном
# запуске скрипта харнесса непонятно, чего ему не хватает.

# --- Кто и над чем работает (выставляет bcf, вручную нужны только при прямом запуске) ---
BCF_HOME=
BCF_PROJECT_ROOT=
BCF_HARNESS_ROOT=
BCF_AGENT_DIR=
BCF_AGENT_DATA_HOME=
BCF_FLEET_DIR=
# Имя участника в заявке на файлы. Пусто = team.member из config/harness.json,
# дальше git config user.name: в отказе второму претенденту должно стоять то имя,
# которое он видит в истории git, а не имя машины.
BCF_CLAIM_OWNER=

# --- Модель кодового агента ---
# Сама команда бэкенда лежит в config/harness.json (agent.command); здесь её доступ.
BCF_API_KEY=
BCF_API_HOST=
BCF_MODEL=
BCF_AUTH_TIMEOUT_SEC=

# --- Вендорские ключи бэкендов (их спрашивает проверка авторизации в bcf doctor) ---
CLAUDE_CODE_OAUTH_TOKEN=
GEMINI_API_KEY=

# --- Роли-субагенты: ходят к модели напрямую по HTTP ---
# Пусто = взять BCF_API_* выше. Без ключа запрос возвращает отказ авторизации, а
# обвязка видит пустой ответ и записывает «субагент ничего не нашёл».
BCF_RETROSPECTOR_API_KEY=
BCF_RETROSPECTOR_ENDPOINT=
BCF_RETROSPECTOR_MODEL=
BCF_SUPERVISOR_API_KEY=
BCF_SUPERVISOR_ENDPOINT=
BCF_SUPERVISOR_MODEL=
BCF_TEST_AUTHOR_API_KEY=
BCF_TEST_AUTHOR_ENDPOINT=
BCF_TEST_AUTHOR_MODEL=
BCF_DIGESTER_API_KEY=
BCF_DIGESTER_ENDPOINT=
BCF_DIGESTER_MODEL=

# --- Где лежат сами роли и вызывающие их скрипты (пусто = стандартные пути) ---
BCF_AGENT_PATH_RETROSPECTOR=
BCF_AGENT_PATH_SUPERVISOR=
BCF_AGENT_PATH_TEST_AUTHOR=
BCF_AGENT_PATH_REFERENCE_DIGESTER=
BCF_INVOKE_RETROSPECTOR=
BCF_INVOKE_SUPERVISOR=
BCF_INVOKE_TEST_AUTHOR=
BCF_INVOKE_REFERENCE_DIGESTER=
BCF_MEMORY_CLIENT=
BCF_BUG_TRACKER=
BCF_FINDING_GATE=
BCF_NONTARGET_DETECTOR=

# --- Векторная память (features.memory) ---
# Адрес базы — в config/memory.config.json, подобранный порт — в .bcf/memory.local.json.
# Пароль по умолчанию лежит в репозитории и годится только для базы на этой же машине:
# для сетевого адреса задай настоящий здесь, иначе bcf memory init откажется работать.
BCF_PG_PASSWORD=
BCF_PG_PORT=
BCF_MEM_CONFIG=
BCF_MEM_CONTAINER=
BCF_MEM_DATA=
BCF_MEM_COMPOSE=
BCF_MEMORY_PROJECT=
BCF_MEMORY_DISABLED=
BCF_MEMORY_INJECT_DISABLED=

# --- Сервер эмбеддингов (любой совместимый с OpenAI /v1/embeddings) ---
MEMORY_EMBED_URL=
MEMORY_EMBED_MODEL=
MEMORY_EMBED_DIM=
MEMORY_LLM_MODEL=

# --- Общая память команды ---
# Путь к eog, если его нет в PATH. Хук перед задачей дописывает её заметки в контекст.
EOG_BIN=

# --- Контекст итерации (выставляет харнесс, читают хуки) ---
BCF_ITERATION_ID=
BCF_ITERATION_DIR=
BCF_RETRO_DIR=
BCF_VERIFY_DIR=
BCF_TASKS_DIR=
BCF_TASK_ID=
BCF_TASK_DESCRIPTION=
BCF_TASK_ID_PATTERN=
BCF_AGENT_SCOPE=
BCF_REFERENCE_FILE=
BCF_ORPHAN_EXTRA_PATTERN=
# Путь к файлу графа текущего прогона. Выставляет граф, читает verify.ps1 и печатает
# graph_hash в вердикт. Для прогонов вне графа (run loop/night) пусто.
BCF_GRAPH_FILE=

# --- Тесты и проверки ---
BCF_TEST_CONFIG=
BCF_TEST_DIR=
BCF_TEST_SPEC_GLOB=
BCF_TEST_REGRESSION_ROOT=
BCF_TIME_DEPENDENT_TESTS=
BCF_HOOKS_CONFIG=

# --- Визуальная фаза ---
BCF_VISION_BUILD_CMD=
BCF_VISION_CONTRACT_CMD=
BCF_VISION_CONTRACT_DIR=
BCF_VISION_PAGES=
BCF_VISION_RESULTS_DIR=

# --- Аварийные выключатели гейтов (=1 выключает; каждый прячет свою проверку) ---
BCF_DONE_GATE_DISABLED=
BCF_DOD_VALIDATOR_DISABLED=
BCF_DODIMMUT_DISABLED=
BCF_DUPID_DISABLED=
BCF_FINDING_GATE_DISABLED=
BCF_MOCK_DETECTOR_DISABLED=
BCF_PROGRESSION_GATE_DISABLED=
BCF_AGENT_INFRA_PROTECT_DISABLED=
BCF_SECRET_SCAN_DISABLED=

# --- Вывод и оболочка ---
BCF_NO_COLOR=
BCF_ASCII=
BCF_BASH=
BCF_REPORT_LIB_ONLY=
BCF_GRAPH_NO_BOARD=

# --- Шов для тестов: подставной агент вместо настоящего CLI ---
BCF_GRAPH_FAKE_AGENT=
BCF_BASH_FORCE_NOT_FOUND=
BCF_SIMULATE_NOT_WINDOWS=
